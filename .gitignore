# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg

# PyInstaller
# Keep .spec files tracked when they contain project build configuration.
*.manifest
*.toc

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checkers and linters
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# IDE/editor files
.idea/
.vscode/
*.swp
*.swo

# Local environment and secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db
desktop.ini
